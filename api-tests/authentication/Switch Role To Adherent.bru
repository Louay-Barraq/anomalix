meta {
  name: Switch Role To Adherent
  type: http
  seq: 2
}

post {
  url: {{base_url}}/auth/switch-role
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
      "targetRole": "ADHERENT"
  }
}

script:post-response {
  const data = res.getBody();
  if (data.token) {
      bru.setEnvVar("token", data.token);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
